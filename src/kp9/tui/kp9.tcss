Screen {
    background: #0b1021;
    color: #c7d0e0;
}

#topbar {
    height: 2;
    padding: 0 1;
    background: #1b2b4b;
    color: #ffb000;
    text-style: bold;
}

#topbar.protected {
    background: #b00020;
    color: #ffffff;
}

#main {
    height: 1fr;
}

#body {
    width: 1fr;
    height: 1fr;
}

#sidebar {
    width: 38;
    max-width: 45%;
    height: 1fr;
}

#sidebar:focus-within {
    border: round #ffb000;
}

View {
    height: 1fr;
    padding: 0 1;
    border: round #00b7eb;
    border-title-color: #ffb000;
    border-title-style: bold;
}

DataTable {
    height: 1fr;
}

#prompt {
    display: none;
}

#crumbs {
    height: 1;
    padding: 0 1;
    background: #1b2b4b;
    color: #00e5ff;
}

#summary, #request-def {
    height: auto;
    padding-bottom: 1;
}

DetailView TabbedContent {
    height: 12;
}

ResponsePanel {
    height: 1fr;
    border-top: solid #00b7eb;
}

#resp-headers {
    color: #8a9bb8;
    padding-bottom: 1;
}

EnvsView #vars {
    height: auto;
    max-height: 12;
    border-top: solid #00b7eb;
}

ConfirmScreen, NameScreen, HelpScreen {
    align: center middle;
}

#dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick #ffb000;
    background: #1b2b4b;
}

RequestEditorScreen {
    align: center middle;
}

#editor {
    width: 100%;
    height: 100%;
    padding: 0 1;
    border: thick #ffb000;
    background: #0b1021;
}

#editor-line, #editor-body-line {
    height: auto;
}

#editor-method, #editor-body-type {
    width: 16;
}

#editor-url {
    width: 1fr;
}

.editor-label {
    width: auto;
    padding: 1 1 0 0;
    color: #ffb000;
}

.editor-pairs {
    height: 5;
}

#editor-body {
    height: 1fr;
}

#editor-error {
    height: auto;
}

#editor-hint {
    height: 1;
}

#var-suggestions {
    overlay: screen;
    position: absolute;
    constrain: inside inside;
    width: auto;
    min-width: 30;
    max-width: 100;
    border: round #00b7eb;
    background: #1b2b4b;
    padding: 0;
}
